APP_NAME="Loterias Online API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=127.0.0.1
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173
SEED_DEFAULT_PASSWORD="Loterias@2026!"

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@loterias.online
MAIL_FROM_NAME="Loterias Online"
LOTTERY_RESULTS_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api/{slug}
LOTTERY_SYNC_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
