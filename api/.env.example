STRIPE_CANCEL_URL=http://127.0.0.1:5173/?payment=cancelled
STRIPE_CURRENCY=brl
RISK_PAYOUT_RATIO=0.70
RISK_SAFETY_RATIO=0.80
RISK_MIN_RESERVE_CENTS=100000
RISK_MAX_BET_CENTS=100000
RISK_TEST_MODE=false
