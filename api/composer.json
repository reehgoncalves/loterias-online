{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "loterias-online/api",
  "type": "project",
  "description": "API Laravel da plataforma Loterias Online.",
  "license": "proprietary",
  "require": { "php": "^8.3", "laravel/framework": "^12.0", "laravel/sanctum": "^4.0", "laravel/tinker": "^2.10" },
  "require-dev": { "fakerphp/faker": "^1.23", "laravel/pail": "^1.2", "laravel/pint": "^1.22", "phpunit/phpunit": "^11.5" },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "setup": ["@php artisan key:generate --ansi", "@php artisan migrate --seed --ansi"], "test": "@php artisan test", "format": "@php vendor/bin/pint" },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true, "php-http/discovery": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}

