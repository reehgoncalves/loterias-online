{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://loterias-online-api.vercel.app/api/:path*"
    },
    {
      "source": "/service/:path*",
      "destination": "https://loterias-online-api.vercel.app/api/:path*"
    }
  ]
}
